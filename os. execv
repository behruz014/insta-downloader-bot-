import subprocess
import sys
import os

def check_for_updates_and_restart():
    """GitHub'dan yangilanishlarni tekshiradi va o'zgarish bo'lsa botni qayta ishga tushiradi"""
    try:
        # Lokaldagi o'zgarishlarni GitHub bilan solishtirish uchun fetch qilamiz
        subprocess.run(["git", "fetch"], check=True, capture_output=True)
        
        # Local va Remote (GitHub) o'rtasidagi farqni tekshiramiz
        status = subprocess.run(["git", "status", "-uno"], capture_output=True, text=True, check=True).stdout
        
        if "Your branch is behind" in status:
            print("🔄 Yangilanish topildi! Kod tortib olinmoqda...")
            subprocess.run(["git", "pull"], check=True)
            print("✅ Bot yangilandi, qayta ishga tushirilmoqda...")
            # Bot jarayonini yangidan ishga tushirish
            os.execv(sys.executable, ['python'] + sys.argv)
        else:
            print("✅ Bot allaqachon eng so'nggi versiyada.")
    except Exception as e:
        print(f"⚠️ Yangilanishni tekshirishda xatolik: {e}")
